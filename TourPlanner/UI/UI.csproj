<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

	<ItemGroup>
		<Compile Remove="UserImages\**" />
		<EmbeddedResource Remove="UserImages\**" />
		<None Remove="UserImages\**" />
		<Page Remove="UserImages\**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Views\Images\hero_maps_static_api.png" />
		<None Remove="Views\Images\HomeIcon.png" />
		<None Remove="Views\Images\ListIcon.png" />
		<None Remove="Views\Images\MapIcon.png" />
		<None Remove="Views\Images\SearchIcon.png" />
		<None Remove="Views\Images\SettingsIcon.png" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Views\Images\hero_maps_static_api.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Views\Images\HomeIcon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Views\Images\ListIcon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Views\Images\MapIcon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Views\Images\SearchIcon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Views\Images\SettingsIcon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PlaceholderTextBox\PlaceholderTextBox.csproj" />
		<ProjectReference Include="..\Business\Business.csproj" />
	</ItemGroup>

</Project>
